#!/bin/bash

#PBS -P ke17
#PBS -q gpuvolta
#PBS -N bhsd_csanet_src_bin_f0
#PBS -l walltime=48:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=64GB
#PBS -l jobfs=20GB
#PBS -l storage=scratch/ke17

set -euo pipefail
umask 007
BHSD_ROOT=/scratch/ke17/bhsd-nnunet
REPO_DIR="$BHSD_ROOT/software/bhsd-nnunet"
PRETRAINED="$BHSD_ROOT/software/pretrained/R50+ViT-B_16.npz"
module purge
module load python3/3.10.4
source "$BHSD_ROOT/envs/bhsd-nnunet-py310/bin/activate"
export nnUNet_raw="$BHSD_ROOT/data/nnUNet_raw"
export nnUNet_preprocessed="$BHSD_ROOT/data/nnUNet_preprocessed"
export nnUNet_results="$BHSD_ROOT/runs/nnUNet_results"
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
test -f "$nnUNet_preprocessed/Dataset002_BHSD_Binary/splits_final.json"
test -f "$PRETRAINED"
cd "$REPO_DIR"
args=(--config csa_net_source_faithful_bhsd_binary_fold0)
if [[ -f "$BHSD_ROOT/runs/source_faithful/csa_net_bhsd_binary_fold0/checkpoint_latest.pth" ]]; then
    args+=(--resume)
fi
python -m source_faithful.train_attention "${args[@]}"
