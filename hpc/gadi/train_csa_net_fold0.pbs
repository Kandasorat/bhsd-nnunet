#!/bin/bash

#PBS -P ke17
#PBS -q gpuvolta
#PBS -N bhsd_csanet_f0
#PBS -r y
#PBS -l walltime=48:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=32GB
#PBS -l jobfs=20GB
#PBS -l storage=scratch/ke17

set -euo pipefail
umask 007

BHSD_ROOT=/scratch/ke17/bhsd-nnunet
REPO_DIR="$BHSD_ROOT/software/bhsd-nnunet"
PRETRAINED="$BHSD_ROOT/software/pretrained/R50+ViT-B_16.npz"

module purge
module load python3/3.10.4
source "$BHSD_ROOT/envs/bhsd-nnunet-py310/bin/activate"

export nnUNet_raw="$BHSD_ROOT/data/nnUNet_raw"
export nnUNet_preprocessed="$BHSD_ROOT/data/nnUNet_preprocessed"
export nnUNet_results="$BHSD_ROOT/runs/nnUNet_results"
export BHSD_RESULTS_DIR="$BHSD_ROOT/runs/experiment_metadata"
export BHSD_CSA_PRETRAINED="$PRETRAINED"
export BHSD_SKIP_EXTENSION_INSTALL=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

if [[ ! -f "$PRETRAINED" ]]; then
    echo "Missing official CSA-Net pretrained weights: $PRETRAINED" >&2
    exit 2
fi

mkdir -p "$BHSD_RESULTS_DIR" "$BHSD_ROOT/logs"
cd "$REPO_DIR"

(
    flock -x 9
    python nnunet25d/install_extension.py
) 9>"$BHSD_ROOT/envs/.nnunet25d-install.lock"

args=(train --config csa_net_official_3slice_fold0 --fold 0)
checkpoint_dir="$nnUNet_results/Dataset001_BHSD/nnUNetTrainer25DCSANetOfficial__nnUNetPlans__2d/fold_0"
if [[ "${BHSD_RESUME:-0}" == "1" ]] || [[ -f "$checkpoint_dir/checkpoint_latest.pth" ]]; then
    args+=(--resume)
fi

python scripts/run_experiment.py "${args[@]}"
